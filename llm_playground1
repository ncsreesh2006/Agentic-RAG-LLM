from llama_cpp import Llama

llm = Llama(
    model_path="./llama-2-7b.Q4_K_M.gguf",
    n_ctx=256,
    verbose=False
)

prompt = "Output exactly this token and nothing else:\nHELLO"

response = llm(
    prompt,
    max_tokens=5,
    temperature=0.0,
    stop=["\n"]
)

print(response["choices"][0]["text"])
